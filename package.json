{
  "name": "daily-checkin-app",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:standalone": "vite build && node build-standalone.cjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "hooks:install": "node scripts/install-hooks.cjs",
    "prepare": "node scripts/install-hooks.cjs",
    "build:electron": "vite build && node build-standalone.cjs && node -e \"require('fs').copyFileSync('dist/index-standalone.html','index-standalone.html');console.log('root index-standalone.html updated')\" && electron-builder --win",
    "verify:backup": "esbuild .workbuddy/verify-backup.mjs --bundle --platform=node --format=esm --outfile=.workbuddy/verify-bundle.mjs --log-level=warning && node .workbuddy/verify-bundle.mjs",
    "verify:stats": "esbuild .workbuddy/verify-stats.mjs --bundle --platform=node --format=esm --outfile=.workbuddy/verify-stats-bundle.mjs --log-level=warning && node .workbuddy/verify-stats-bundle.mjs",
    "verify:almanac": "esbuild .workbuddy/verify-almanac.mjs --bundle --platform=node --format=esm --outfile=.workbuddy/verify-almanac-bundle.mjs --log-level=warning && node .workbuddy/verify-almanac-bundle.mjs",
    "verify:webdav": "esbuild .workbuddy/verify-webdav.mjs --bundle --platform=node --format=esm --outfile=.workbuddy/verify-webdav-bundle.mjs --log-level=warning && node .workbuddy/verify-webdav-bundle.mjs",
    "verify:todo": "esbuild .workbuddy/verify-todo.mjs --bundle --platform=node --format=esm --outfile=.workbuddy/verify-todo-bundle.mjs --log-level=warning && node .workbuddy/verify-todo-bundle.mjs",
    "verify:persistence": "esbuild .workbuddy/verify-persistence.mjs --bundle --platform=node --format=esm --outfile=.workbuddy/verify-persistence-bundle.mjs --log-level=warning && node .workbuddy/verify-persistence-bundle.mjs",
    "verify:config": "esbuild .workbuddy/verify-config.mjs --bundle --platform=node --format=esm --outfile=.workbuddy/verify-config-bundle.mjs --log-level=warning && node .workbuddy/verify-config-bundle.mjs",
    "verify": "npm run verify:backup && npm run verify:stats && npm run verify:almanac && npm run verify:webdav && npm run verify:todo && npm run verify:persistence && npm run verify:config"
  },
  "description": "DayMark 每日打卡与待办清单桌面应用",
  "author": "DayMark",
  "build": {
    "appId": "com.daymark.app",
    "productName": "DayMark",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "index-standalone.html",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.14.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.18.20",
    "lunar-javascript": "^1.7.7",
    "postcss": "^8.4.27",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.0"
  }
}
